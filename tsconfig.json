{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["bun"],
    "lib": ["ESNext"]
  },
  "include": ["packages/*/src", "packages/*/test", "apps/*/src", "apps/*/test"],
  "exclude": ["apps/worker"]
}
