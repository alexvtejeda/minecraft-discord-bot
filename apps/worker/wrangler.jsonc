{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "mc-bot",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mc-bot",
			"database_id": "e42fca9f-ba2e-49de-ac0b-cd9d994e34ab",
			"migrations_dir": "migrations"
		},
	],
	"r2_buckets": [
